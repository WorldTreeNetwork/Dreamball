{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamball:root@2.0.0",
  "title": "DreamBall Root Protocol Schema",
  "description": "Authoritative shape source for every root wire-format type in the DreamBall protocol. Hand-authored from src/protocol.zig + src/protocol_v2.zig per FR2. Per D-018 + D-029 (sprint-002 architecture decisions): this file is canonical for field shapes; the CBOR encoding algorithm remains canonical in Zig (src/*.zig) with golden test vectors. Recrypt naming inheritance (TC9): every type name matches its recrypt-aligned name verbatim (see ../../recrypt/docs/wire-protocol.md). x-extension keys (x-zig, x-zig-type, x-cbor, x-cbor-section, x-cbor-attribute-encoding, x-format-version, x-wire-type, x-wire-attribute, x-optional, x-ts-type) carry generator hints outside the JSON-Schema core; validators ignore them, generators consume them. Spike findings: docs/decisions/2026-04-28-codegen-spike-findings.md.",
  "type": "object",
  "$defs": {
    "Bytes32": {
      "$comment": "fp:bytes32 — 32-byte blake3 fingerprint or Ed25519 pubkey. Hex at JSON layer, byte-string-32 at CBOR layer.",
      "type": "string",
      "x-cbor": "byte-string-32",
      "x-zig": "[32]u8",
      "x-ts-type": "Bytes32"
    },
    "Fingerprint": {
      "$comment": "Blake3 fingerprint — distinct from Bytes32 only in TS naming for clarity.",
      "type": "string",
      "x-cbor": "byte-string-32",
      "x-zig": "Fingerprint",
      "x-ts-type": "Fingerprint"
    },
    "Rfc3339": {
      "$comment": "RFC 3339 UTC string at JSON layer; tag-1 epoch-time at CBOR layer. Per spike Gap 3.",
      "type": "string",
      "x-cbor": "tag-1-epoch-time",
      "x-zig": "i64",
      "x-ts-type": "Rfc3339"
    },
    "Stage": {
      "$comment": "Closed-enum lifecycle tier wrapping the signature bag. seed = pre-signing; dreamball = signed; dragonball = sealed.",
      "type": "string",
      "enum": ["seed", "dreamball", "dragonball"],
      "x-cbor": "text-string",
      "x-zig": "Stage"
    },
    "DreamBallType": {
      "$comment": "The six DreamBall categories. Wire form is the short tag; envelope.type literal is `ball.dreamball.<tag>`.",
      "type": "string",
      "enum": ["avatar", "agent", "tool", "relic", "field", "guild"],
      "x-cbor": "text-string",
      "x-zig": "DreamBallType"
    },
    "MemoryConnectionKind": {
      "type": "string",
      "enum": ["semantic", "emotional", "temporal", "other"],
      "x-cbor": "text-string",
      "x-zig": "MemoryConnectionKind"
    },
    "InteractionKind": {
      "type": "string",
      "enum": ["speak", "listen", "act", "receive"],
      "x-cbor": "text-string",
      "x-zig": "InteractionKind"
    },
    "ActionKind": {
      "$comment": "Closed enum of 9 action kinds; wire form is the kebab-case string. Per src/protocol_v2.zig ActionKind.",
      "type": "string",
      "enum": [
        "palace-minted",
        "room-added",
        "avatar-inscribed",
        "aqueduct-created",
        "move",
        "true-naming",
        "inscription-updated",
        "inscription-orphaned",
        "inscription-pending-embedding"
      ],
      "x-cbor": "text-string",
      "x-zig": "ActionKind"
    },
    "AqueductPhase": {
      "type": "string",
      "enum": ["in", "out", "standing", "resonant"],
      "x-cbor": "text-string",
      "x-zig": "AqueductPhase"
    },
    "SignatureAlg": {
      "$comment": "Closed enum picklist for the signed-attribute algorithm. Per spike target #3.",
      "type": "string",
      "enum": ["ed25519", "ml-dsa-87"],
      "x-cbor": "text-string",
      "x-zig": "[]const u8"
    },
    "SignatureTierWrapper": {
      "$comment": "Lifted from tools/schema-gen/spike/schemas/signature-tier-wrapper-2.0.0.json. The Signature pair (alg + value) the dCBOR `signed` attribute carries; the Stage tier wraps the bag at envelope-level. Per spike Gap 4: the value position is a positional 2-array at CBOR.",
      "type": "object",
      "x-zig-type": "Signature",
      "x-wire-attribute": "signed",
      "x-format-version": [1, 2],
      "x-cbor-attribute-encoding": "v2-attribute-pair-signed-with-2-array-alg-value",
      "required": ["alg", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "$ref": "#/$defs/SignatureAlg",
          "x-cbor-section": "attribute-pair-position-0"
        },
        "value": {
          "$comment": "Opaque signature bytes — Ed25519 = 64 B, ML-DSA-87 = 4627 B.",
          "type": "string",
          "x-cbor": "byte-string-variable",
          "x-zig": "[]const u8",
          "x-cbor-section": "attribute-pair-position-1",
          "x-ts-type": "Base58"
        }
      }
    },
    "Asset": {
      "$comment": "Per src/protocol.zig Asset.",
      "type": "object",
      "x-zig-type": "Asset",
      "required": ["media-type", "hash"],
      "additionalProperties": false,
      "properties": {
        "media-type": {
          "type": "string",
          "x-cbor": "text-string",
          "x-zig": "[]const u8"
        },
        "hash": {
          "$ref": "#/$defs/Bytes32"
        },
        "url": {
          "$comment": "JSON key is singular `url`, an array — it projects the repeated CBOR `url` attribute (one assertion per location), so it matches the wire key and the JSON import/export. The in-memory Zig struct field is `urls`.",
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-cbor": "array-of-text-string",
          "x-zig": "[]const []const u8"
        },
        "embedded": {
          "type": ["string", "null"],
          "x-cbor": "byte-string-variable",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "size": {
          "type": ["integer", "null"],
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "?u64",
          "x-optional": true
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Look": {
      "$comment": "Per src/protocol.zig Look.",
      "type": "object",
      "x-zig-type": "Look",
      "additionalProperties": false,
      "properties": {
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/Asset" },
          "x-zig": "[]const Asset"
        },
        "preview": {
          "oneOf": [{ "$ref": "#/$defs/Asset" }, { "type": "null" }],
          "x-zig": "?Asset",
          "x-optional": true
        },
        "background": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Feel": {
      "$comment": "Per src/protocol.zig Feel.",
      "type": "object",
      "x-zig-type": "Feel",
      "additionalProperties": false,
      "properties": {
        "personality": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "voice": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "values": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "tempo": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Skill": {
      "$comment": "Per src/protocol.zig Skill — a named capability inside Act.",
      "type": "object",
      "x-zig-type": "Skill",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "x-cbor": "text-string",
          "x-zig": "[]const u8"
        },
        "trigger": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "body": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "asset": {
          "oneOf": [{ "$ref": "#/$defs/Asset" }, { "type": "null" }],
          "x-zig": "?Asset",
          "x-optional": true
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Act": {
      "$comment": "Per src/protocol.zig Act.",
      "type": "object",
      "x-zig-type": "Act",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "system-prompt": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/Skill" },
          "x-zig": "[]const Skill"
        },
        "scripts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Asset" },
          "x-zig": "[]const Asset"
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Vec3": {
      "type": "object",
      "x-zig-type": "Vec3",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "y": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "z": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" }
      }
    },
    "CameraRing": {
      "type": "object",
      "x-zig-type": "CameraRing",
      "required": ["radius", "tilt", "fov"],
      "additionalProperties": false,
      "properties": {
        "radius": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "tilt": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "fov": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" }
      }
    },
    "OmnisphericalGrid": {
      "$comment": "Per src/protocol_v2.zig OmnisphericalGrid (PROTOCOL.md §12.2). resolution is forward-only — see VISION.md §4.4.5.",
      "type": "object",
      "x-zig-type": "OmnisphericalGrid",
      "x-wire-type": "ball.omnispherical-grid",
      "additionalProperties": false,
      "properties": {
        "pole-north": { "$ref": "#/$defs/Vec3" },
        "pole-south": { "$ref": "#/$defs/Vec3" },
        "camera-rings": {
          "type": "array",
          "items": { "$ref": "#/$defs/CameraRing" },
          "x-zig": "[]const CameraRing"
        },
        "layer-depth": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u32"
        },
        "resolution": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u32"
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "MemoryNodeLookupEntry": {
      "$comment": "Inline lookups: name → sort-key value.",
      "type": "object",
      "x-zig-type": "MemoryNode.LookupEntry",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "value": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" }
      }
    },
    "MemoryNode": {
      "type": "object",
      "x-zig-type": "MemoryNode",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u64"
        },
        "content": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "lookups": {
          "type": "array",
          "items": { "$ref": "#/$defs/MemoryNodeLookupEntry" },
          "x-zig": "[]const MemoryNode.LookupEntry"
        },
        "created": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        },
        "last-recalled": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        }
      }
    },
    "MemoryConnection": {
      "type": "object",
      "x-zig-type": "MemoryConnection",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u64"
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u64"
        },
        "kind": { "$ref": "#/$defs/MemoryConnectionKind" },
        "strength": {
          "type": "number",
          "x-cbor": "smallest-float",
          "x-zig": "f64"
        },
        "label": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Memory": {
      "$comment": "Per src/protocol_v2.zig Memory (PROTOCOL.md §12.3).",
      "type": "object",
      "x-zig-type": "Memory",
      "x-wire-type": "ball.memory",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/MemoryNode" },
          "x-zig": "[]const MemoryNode"
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/MemoryConnection" },
          "x-zig": "[]const MemoryConnection"
        },
        "last-updated": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        }
      }
    },
    "Triple": {
      "$comment": "Per src/protocol_v2.zig Triple. The `to` field carries either a text value or a fingerprint reference.",
      "type": "object",
      "x-zig-type": "Triple",
      "required": ["from", "label", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "label": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "to": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" }
      }
    },
    "KnowledgeGraph": {
      "$comment": "Per src/protocol_v2.zig KnowledgeGraph (PROTOCOL.md §12.4).",
      "type": "object",
      "x-zig-type": "KnowledgeGraph",
      "x-wire-type": "ball.knowledge-graph",
      "additionalProperties": false,
      "properties": {
        "triples": {
          "type": "array",
          "items": { "$ref": "#/$defs/Triple" },
          "x-zig": "[]const Triple"
        },
        "source": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "EmotionalAxis": {
      "type": "object",
      "x-zig-type": "EmotionalAxis",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "value": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "min": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" },
        "max": { "type": "number", "x-cbor": "smallest-float", "x-zig": "f64" }
      }
    },
    "EmotionalRegister": {
      "$comment": "Per src/protocol_v2.zig EmotionalRegister (PROTOCOL.md §12.5).",
      "type": "object",
      "x-zig-type": "EmotionalRegister",
      "x-wire-type": "ball.emotional-register",
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/EmotionalAxis" },
          "x-zig": "[]const EmotionalAxis"
        },
        "observed-at": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        }
      }
    },
    "Interaction": {
      "type": "object",
      "x-zig-type": "Interaction",
      "required": ["turn", "actor", "kind"],
      "additionalProperties": false,
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "x-cbor": "smallest-uint",
          "x-zig": "u32"
        },
        "actor": { "$ref": "#/$defs/Fingerprint" },
        "kind": { "$ref": "#/$defs/InteractionKind" },
        "content": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        },
        "timestamp": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        },
        "outcome": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "InteractionSet": {
      "$comment": "Per src/protocol_v2.zig InteractionSet (PROTOCOL.md §12.6). set-id is content-addressable: 16 random bytes at creation time.",
      "type": "object",
      "x-zig-type": "InteractionSet",
      "x-wire-type": "ball.interaction-set",
      "required": ["set-id"],
      "additionalProperties": false,
      "properties": {
        "set-id": {
          "type": "string",
          "x-cbor": "byte-string-16",
          "x-zig": "[16]u8"
        },
        "interactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Interaction" },
          "x-zig": "[]const Interaction"
        },
        "created": {
          "oneOf": [{ "$ref": "#/$defs/Rfc3339" }, { "type": "null" }],
          "x-cbor": "tag-1-epoch-time",
          "x-zig": "?i64",
          "x-optional": true
        }
      }
    },
    "GuildPolicy": {
      "$comment": "Per src/protocol_v2.zig GuildPolicy (PROTOCOL.md §12.7). Slot bucket lists; default split is sensible.",
      "type": "object",
      "x-zig-type": "GuildPolicy",
      "x-wire-type": "ball.guild-policy",
      "additionalProperties": false,
      "properties": {
        "public": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "guild-only": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "admin-only": {
          "type": "array",
          "items": { "type": "string", "x-cbor": "text-string" },
          "x-zig": "[]const []const u8"
        },
        "note": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "SecretRef": {
      "$comment": "Per src/protocol_v2.zig SecretRef (PROTOCOL.md §12.8). locator is opaque (e.g. recrypt://…).",
      "type": "object",
      "x-zig-type": "SecretRef",
      "x-wire-type": "ball.secret-ref",
      "required": ["name", "locator"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "locator": { "type": "string", "x-cbor": "text-string", "x-zig": "[]const u8" },
        "issued-by": {
          "oneOf": [{ "$ref": "#/$defs/Fingerprint" }, { "type": "null" }],
          "x-zig": "?Fingerprint",
          "x-optional": true
        },
        "description": {
          "type": ["string", "null"],
          "x-cbor": "text-string",
          "x-zig": "?[]const u8",
          "x-optional": true
        }
      }
    },
    "Transmission": {
      "$comment": "Per src/protocol_v2.zig Transmission (PROTOCOL.md §12.9). When sender-identity is present the envelope bumps to format-version 3.",
      "type": "object",
      "x-zig-type": "Transmission",
      "x-wire-type": "ball.transmission",
      "x-format-version": [2, 3],
      "required": ["tool-fp", "target-fp", "via-guild"],
      "additionalProperties": false,
      "properties": {
        "tool-fp": { "$ref": "#/$defs/Fingerprint" },
        "target-fp": { "$ref": "#/$defs/Fingerprint" },
        "via-guild": { "$ref": "#/$defs/Fingerprint" },
        "sender-identity": {
